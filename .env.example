# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODERATION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Moderation pipeline. OpenAI is primary; Gemini remains available as an explicit provider.
MODERATION_MODE=openai
MODERATION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_TRIAGE_MODEL=gemini-3.1-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ENABLE_POLICY_RETRIEVAL=false
MODERATION_REVIEW_THRESHOLD=0.80
MODERATION_AUTO_ACTION_THRESHOLD=0.90
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
ALLOW_MOCK_FALLBACK=false

# ---- Conversation analysis / feedback ----
ESCALATION_REVIEW_THRESHOLD=0.65
ESCALATION_CRITICAL_THRESHOLD=0.85
SIMILAR_CASE_LIMIT=5
ENABLE_CASE_BASED_LEARNING=true

# ---- Database ----
DATABASE_URL=sqlite:///./data/community_channel.db
# PostgreSQL can be configured later for production when a driver is added.

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- YouTube integration ----
# public_api reads public comments with an API key; imported_dataset is offline demo data.
YOUTUBE_DATA_MODE=public_api
YOUTUBE_API_KEY=
YOUTUBE_DEFAULT_VIDEO_ID=
YOUTUBE_MAX_RESULTS_PER_SYNC=50
YOUTUBE_MAX_THREADS_PER_ANALYSIS=50
YOUTUBE_DATASET_PATH=./data/youtube_demo
YOUTUBE_DATA_RETENTION_DAYS=30
YOUTUBE_ALLOW_PUBLIC_READ=true
YOUTUBE_AUTHORIZED_MODE=false
YOUTUBE_ACTION_MODE=simulated
YOUTUBE_SYNC_MODE=manual
YOUTUBE_POLL_INTERVAL_SECONDS=120
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/youtube/callback
YOUTUBE_OAUTH_SCOPE=https://www.googleapis.com/auth/youtube.force-ssl
YOUTUBE_CHANNEL_ID=
TOKEN_ENCRYPTION_KEY=
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
