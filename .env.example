# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODERATION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_ENABLED=false
KNOWLEDGE_EMBEDDING_MIN_SCORE=0.38
KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
RAG_CANDIDATE_LIMIT=6
RAG_RELEVANCE_THRESHOLD=0.30
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Moderation pipeline. OpenAI is primary; Gemini remains available as an explicit provider.
MODERATION_MODE=openai
MODERATION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_TRIAGE_MODEL=gemini-3.1-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ENABLE_POLICY_RETRIEVAL=false
MODERATION_REVIEW_THRESHOLD=0.80
MODERATION_AUTO_ACTION_THRESHOLD=0.90
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
ALLOW_MOCK_FALLBACK=false

# ---- Conversation analysis / feedback ----
ESCALATION_REVIEW_THRESHOLD=0.65
ESCALATION_CRITICAL_THRESHOLD=0.85
SIMILAR_CASE_LIMIT=5
ENABLE_CASE_BASED_LEARNING=true

# ---- Database ----
DATABASE_URL=sqlite:///./data/community_channel.db
# PostgreSQL can be configured later for production when a driver is added.

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- Community Operations Copilot connectors (optional) ----
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=
DISCORD_LISTENER_ENABLED=false
DISCORD_REPLY_MAX_CHARS=1800
DISCORD_RAG_LLM_ENABLED=true
DISCORD_RAG_MODEL=gpt-4o-mini
DISCORD_RAG_TEMPERATURE=0.2
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_LISTENER_ENABLED=false
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
TELEGRAM_REPLY_MAX_CHARS=3500
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_ALERT_RISK_THRESHOLD=0.55
ZALO_ACCESS_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
OPERATIONS_DEMO_MODE=true
OPERATIONS_USE_LLM=false
KNOWLEDGE_EXTRACTION_ENABLED=true
KNOWLEDGE_EXTRACTION_MODEL=gpt-4o-mini
KNOWLEDGE_EXTRACTION_TEMPERATURE=0.0
KNOWLEDGE_ARCHIVE_DIR=./data/knowledge_uploads
OPERATIONS_INCIDENT_WINDOW_MINUTES=60
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
