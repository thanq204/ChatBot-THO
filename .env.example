# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODERATION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
SEMANTIC_EMBEDDING_CACHE_SIZE=128

# ---- FAQ/RAG PostgreSQL Configuration for RAG (Docker or Cloud)
# To use Supabase/Neon, set FAQ_PG_DSN. This overrides individual PG settings below.
# Runtime production: Supabase PostgreSQL DSN. Do not commit the real password.
FAQ_PG_DSN=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
FAQ_PG_HOST=localhost
FAQ_PG_PORT=5433
FAQ_PG_DB=faq_rag
FAQ_PG_USER=faq_user
FAQ_PG_PASSWORD=faq_pass_dev
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=8
FAQ_SIMILARITY_THRESHOLD=0.75

# ---- Dashboard authentication (PostgreSQL/Supabase) ----
# Set these in .env, never commit their real values.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_MINUTES=60
# First startup creates this root admin only when both values are set.
AUTH_ROOT_ADMIN_EMAIL=
AUTH_ROOT_ADMIN_PASSWORD=
# Google OAuth Web Client ID (type: Web application). The frontend reads this
# safely from /api/v1/auth/google/config, so VITE_GOOGLE_CLIENT_ID is optional.
GOOGLE_OAUTH_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=
KNOWLEDGE_EMBEDDING_ENABLED=true
KNOWLEDGE_EMBEDDING_MIN_SCORE=0.38
KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
RAG_CANDIDATE_LIMIT=6
RAG_RELEVANCE_THRESHOLD=0.52
RAG_VECTOR_MIN_SCORE=0.38
RAG_SEMANTIC_ONLY_MIN_SCORE=0.62
RAG_QUERY_COVERAGE_MIN_SCORE=0.24
RAG_MINIMUM_MARGIN=0.025
RAG_RERANK_VECTOR_WEIGHT=0.58
RAG_RERANK_LEXICAL_WEIGHT=0.30
RAG_RERANK_PHRASE_WEIGHT=0.12
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Moderation pipeline. OpenAI is primary; Gemini remains available as an explicit provider.
MODERATION_MODE=openai
MODERATION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_TRIAGE_MODEL=gemini-3.1-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ENABLE_POLICY_RETRIEVAL=false
MODERATION_POLICY_SEMANTIC_THRESHOLD=0.72
MODERATION_REVIEW_THRESHOLD=0.80
MODERATION_AUTO_ACTION_THRESHOLD=0.90
MODERATION_POLICY_CACHE_SECONDS=15
# Anti-spam and EXP thresholds. Reactions count distinct non-bot users.
SPAM_REPEAT_WINDOW_SECONDS=120
SPAM_REPEAT_MESSAGE_THRESHOLD=3
REPUTATION_HELPFUL_REACTION_THRESHOLD=3
REPUTATION_BLOCK_LINK_REACTION_THRESHOLD=3
# Seller history becomes displayable only after both minimums; this is not a safety certification.
SELLER_ASSESSMENT_MODEL=gpt-4o-mini
SELLER_MIN_VERIFIED_TRANSACTIONS=3
SELLER_MIN_UNIQUE_BUYERS=3
SELLER_REVIEW_BURST_THRESHOLD=5
SELLER_REVIEW_BURST_WINDOW_HOURS=24
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
ALLOW_MOCK_FALLBACK=false

# ---- Conversation analysis / feedback ----
ESCALATION_REVIEW_THRESHOLD=0.65
ESCALATION_CRITICAL_THRESHOLD=0.85
SIMILAR_CASE_LIMIT=5
ENABLE_CASE_BASED_LEARNING=true
MODERATION_CONTEXT_WINDOW_MINUTES=10
MODERATION_CONTEXT_MESSAGE_LIMIT=12
MODERATION_MEMORY_EMBEDDING_ENABLED=true
MODERATION_MEMORY_LLM_VERIFY_ENABLED=true
MODERATION_MEMORY_LLM_CANDIDATE_THRESHOLD=0.55
MODERATION_MEMORY_LLM_MODEL=gpt-4o-mini
FAQ_SEMANTIC_CLUSTERING_ENABLED=true
FAQ_CLUSTER_CANDIDATE_THRESHOLD=0.55
FAQ_CLUSTER_AUTO_MERGE_THRESHOLD=0.95
FAQ_SEMANTIC_MATCH_THRESHOLD=0.82
FAQ_CLUSTERING_MODEL=gpt-4o-mini
FAQ_TOP_LIMIT=10
MODERATION_MEMORY_SIMILARITY_THRESHOLD=0.90

# ---- Database ----
# Only for explicitly isolated unit tests. When FAQ_PG_DSN is set, runtime uses Supabase.
DATABASE_URL=sqlite:///./data/community_channel.db

# ---- Vector Store ----
# Kept for compatibility with older local experiments; not the production vector store.
CHROMA_PERSIST_DIR=./data/chroma

# ---- Community Operations Copilot connectors (optional) ----
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=
# Required to unlock /trade_open, /trade_confirm, /trade_review and /seller_check.
DISCORD_TRADE_CHANNEL_ID=
DISCORD_LISTENER_ENABLED=false
DISCORD_REPLY_MAX_CHARS=1800
DISCORD_RAG_LLM_ENABLED=true
DISCORD_RAG_MODEL=gpt-4o-mini
DISCORD_RAG_TEMPERATURE=0.2
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_LISTENER_ENABLED=false
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
TELEGRAM_REPLY_MAX_CHARS=3500
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_ALERT_RISK_THRESHOLD=0.55
MODERATION_AUTO_WARN_DM_ENABLED=false
ZALO_ACCESS_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
OPERATIONS_DEMO_MODE=true
OPERATIONS_USE_LLM=false
OPERATIONS_SEED_DEFAULTS=false
OPERATIONS_STARTUP_MAINTENANCE_ENABLED=false
KNOWLEDGE_EXTRACTION_ENABLED=true
KNOWLEDGE_EXTRACTION_MODEL=gpt-4o-mini
KNOWLEDGE_EXTRACTION_TEMPERATURE=0.0
KNOWLEDGE_ARCHIVE_DIR=./data/knowledge_uploads
OPERATIONS_INCIDENT_WINDOW_MINUTES=60
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
